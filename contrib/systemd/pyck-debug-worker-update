#!/usr/bin/env bash
# Pull-based auto-updater for /usr/local/bin/pyck-debug-worker (README,
# "Auto-update"). Run by pyck-debug-worker-update.service/.timer.
#
# Installs the newest GitHub release of the installed major version on
# UPDATE_CHANNEL: test follows pre-releases (vX.Y.Z-rc.N), prod follows
# releases (vX.Y.Z). Verifies it against checksums.txt and its --version,
# stops the active units, swaps the binary (old one kept as <binary>.prev),
# starts them again and rolls back if any is not active 10s later.
#
# Environment: UPDATE_CHANNEL (test or prod, set in the .service), GITHUB_TOKEN
# (read-only Contents on the repo) if the repo is private.
set -euo pipefail

REPO=pyck-ai/pyck-debug-worker
BIN=/usr/local/bin/pyck-debug-worker
# Release archive: ${ARCHIVE}_<version>_linux_<arch>.tar.gz, holding ${BIN##*/}.
ARCHIVE=pyck-debug-worker
# systemd units running $BIN.
UNITS='pyck-debug-worker@*.service'
LOCK=/run/lock/pyck-debug-worker-update.lock

# --- Shared updater body, kept identical across pyck worker repos. ---

API=https://api.github.com/repos/$REPO

log() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# GET from the GitHub API. The token goes through a curl config on a
# process-substituted fd, so it never shows up in argv. curl does not forward
# the Authorization header across the redirect to object storage.
github() {
  local url=$1; shift
  if [[ -n ${GITHUB_TOKEN:-} ]]; then
    curl -fsSL -K <(printf 'header = "Authorization: Bearer %s"\n' "$GITHUB_TOKEN") "$@" "$url"
  else
    curl -fsSL "$@" "$url"
  fi
}

# Prints the newest of the versions on stdin. A pre-release sorts before its
# release (v1.0.0-rc.2 < v1.0.0): `-rc.` becomes `~rc.` for sort -V.
newest() {
  sed 's/-rc\./~rc./' | sort -V | tail -n1 | sed 's/~rc\./-rc./'
}

# Atomically replace $BIN with $1.
install_bin() {
  local tmp_bin=${BIN%/*}/.${BIN##*/}.new
  install -m0755 "$1" "$tmp_bin"
  mv -f "$tmp_bin" "$BIN"
}

case ${UPDATE_CHANNEL:-} in
  test) prerelease=true suffix='-rc\.[0-9]+' ;;
  prod) prerelease=false suffix='' ;;
  *) die "UPDATE_CHANNEL must be test or prod, got '${UPDATE_CHANNEL:-}'" ;;
esac

exec 9>"$LOCK"
if ! flock -n 9; then
  log "another update is already running, exiting"
  exit 0
fi

[[ -x $BIN ]] || die "$BIN not found"
current=$("$BIN" --version 2>/dev/null) || die "$BIN does not support --version; install a release that does by hand"
current=${current%% *}
[[ $current =~ ^v([0-9]+)\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]] || die "cannot parse installed version '$current'"
major=${BASH_REMATCH[1]}

releases=$(github "$API/releases?per_page=100")
target=$(jq -r --argjson pre "$prerelease" --arg re "^v${major}\\.[0-9]+\\.[0-9]+${suffix}\$" \
  '.[] | select((.draft | not) and .prerelease == $pre) | .tag_name | select(test($re))' <<<"$releases" |
  newest)
if [[ -z $target || $(printf '%s\n' "$current" "$target" | newest) == "$current" ]]; then
  log "up to date ($current, channel $UPDATE_CHANNEL)"
  exit 0
fi

case $(uname -m) in
  x86_64) arch=amd64 ;;
  aarch64) arch=arm64 ;;
  *) die "unsupported architecture $(uname -m)" ;;
esac

tarball=${ARCHIVE}_${target#v}_linux_${arch}.tar.gz
asset_id() {
  jq -er --arg tag "$target" --arg name "$1" \
    '.[] | select(.tag_name == $tag) | .assets[] | select(.name == $name) | .id' <<<"$releases" ||
    die "release $target has no asset $1"
}
tarball_id=$(asset_id "$tarball")
checksums_id=$(asset_id checksums.txt)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
log "downloading $target ($tarball)"
github "$API/releases/assets/$tarball_id" -H 'Accept: application/octet-stream' -o "$tmp/$tarball"
github "$API/releases/assets/$checksums_id" -H 'Accept: application/octet-stream' -o "$tmp/checksums.txt"

grep -qE "^[0-9a-f]{64}  ${tarball//./\\.}\$" "$tmp/checksums.txt" || die "$tarball is not listed in checksums.txt"
(cd "$tmp" && sha256sum -c --ignore-missing --quiet checksums.txt) || die "checksum mismatch for $tarball"
tar -xzf "$tmp/$tarball" -C "$tmp" "${BIN##*/}"
new=$("$tmp/${BIN##*/}" --version 2>/dev/null) || die "downloaded $target does not support --version"
[[ ${new%% *} == "$target" ]] || die "downloaded binary reports '$new', expected $target"

units=()
while read -r unit _; do
  units+=("$unit")
done < <(systemctl list-units --state=active --plain --no-legend "$UNITS")

log "updating $current -> $target, units: ${units[*]:-none}"
if ((${#units[@]})); then
  log "stopping ${units[*]}"
  systemctl stop "${units[@]}"
fi
cp -p "$BIN" "$BIN.prev"
install_bin "$tmp/${BIN##*/}"
((${#units[@]})) || { log "updated to $target (no active units)"; exit 0; }

log "starting ${units[*]}"
systemctl start "${units[@]}" || true
sleep 10
failed=()
for unit in "${units[@]}"; do
  systemctl is-active --quiet "$unit" || failed+=("$unit")
done
((${#failed[@]})) || { log "updated to $target"; exit 0; }

log "not active after update: ${failed[*]}; rolling back to $current"
systemctl stop "${units[@]}" || true
install_bin "$BIN.prev"
systemctl start "${units[@]}" || true
die "update to $target failed health check, rolled back to $current"
